[
    { "start": 1.5, "duration": 2.2, "type": "reason", "text": "Me encantas, Fiorella." },
    { "start": 4.2, "duration": 3.0, "type": "reason", "text": "En poquitos días será ya casi un año desde que empezamos a escribir nuestra historia." },

    { "start": 7.7, "duration": 3.5, "type": "number", "text": "RAZÓN 1!" },
    { "start": 11.5, "duration": 4.2, "type": "reason", "text": "Me das una razón de despertar,\nsabiendo que unos buenos días se intercambiarán." },

    { "start": 16.2, "duration": 3.5, "type": "number", "text": "RAZÓN 2!" },
    { "start": 20, "duration": 3.6, "type": "reason", "text": "Verte a los ojos me fascina.\nSimplemente me cautiva." },

    { "start": 24.1, "duration": 3.5, "type": "number", "text": "RAZÓN 3!" },
    { "start": 27.9, "duration": 5.2, "type": "reason", "text": "Todas nuestras discusiones se terminan resolviendo con besos.\nMe has permitido entrar a tu puerta y siempre darte un abrazo." },

    { "start": 33.6, "duration": 3.5, "type": "number", "text": "RAZÓN 4!" },
    { "start": 37.4, "duration": 4.6, "type": "reason", "text": "Cuando no te tengo conmigo,\ntu encanto llega hasta perpetuar mis sueños." },

    { "start": 42.5, "duration": 3.5, "type": "number", "text": "RAZÓN 5!" },
    { "start": 46.3, "duration": 5.2, "type": "reason", "text": "Mira un año atrás: ¿somos los mismos?\nCreo que somos mejores que antes.\nTe amo, te extraño y te deseo." },

    { "start": 52, "duration": 3.5, "type": "number", "text": "RAZÓN 6!" },
    { "start": 55.8, "duration": 4.2, "type": "reason", "text": "Eres la dueña de mis sueños,\nmis misterios y mis pensamientos." },

    { "start": 60.5, "duration": 3.5, "type": "number", "text": "RAZÓN 7!" },
    { "start": 64.3, "duration": 4.6, "type": "reason", "text": "Te ha dibujado un pincel de talento celestial,\na mi manera de ver nunca habría un rival." },

    { "start": 69.4, "duration": 3.5, "type": "number", "text": "RAZÓN 8!" },
    { "start": 73.2, "duration": 4.4, "type": "reason", "text": "Aceptas mis ráfagas de cursilerías, mis enojos,\ny entiendes mi forma de amar." },

    { "start": 78.1, "duration": 16.0, "type": "flower", "text": "" },

    { "start": 94.6, "duration": 3.5, "type": "number", "text": "RAZÓN 9!" },
    { "start": 98.4, "duration": 3.6, "type": "reason", "text": "Tienes todo para ser buena mamá." },

    { "start": 102.5, "duration": 3.1, "type": "number", "text": "CUENTA" },
    { "start": 106.1, "duration": 3.1, "type": "number", "text": "3" },
    { "start": 109.7, "duration": 3.1, "type": "number", "text": "2" },
    { "start": 113.3, "duration": 3.1, "type": "number", "text": "1" },
    { "start": 116.9, "duration": 2.2, "type": "reason", "text": "¡Nuestro primer <b>a</b>niversari<b>o</b>!" },
    { "start": 119.6, "duration": 4.9, "type": "number", "text": "¡TE AMO!" }
