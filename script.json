    { "start": 9.2, "duration": 2.2, "type": "reason", "text": "Me encantas, Fiorella." },
    { "start": 11.9, "duration": 2.4, "type": "reason", "text": "Hace un año que me encantas." },

    { "start": 14.8, "duration": 0.9, "type": "number", "text": "RAZÓN 1!" },
    { "start": 15.9, "duration": 4.2, "type": "reason", "text": "Me das una razón de despertar,\nsabiendo que unos buenos días se intercambiarán." },

    { "start": 20.5, "duration": 0.9, "type": "number", "text": "RAZÓN 2!" },
    { "start": 21.6, "duration": 3.6, "type": "reason", "text": "Verte a los ojos me fascina.\nSimplemente me cautiva." },

    { "start": 25.6, "duration": 0.9, "type": "number", "text": "RAZÓN 3!" },
    { "start": 26.7, "duration": 5.2, "type": "reason", "text": "Todas nuestras discusiones se terminan resolviendo con besos.\nMe has permitido entrar a tu puerta y siempre darte un abrazo." },

    { "start": 32.3, "duration": 0.9, "type": "number", "text": "RAZÓN 4!" },
    { "start": 33.4, "duration": 4.6, "type": "reason", "text": "Cuando no te tengo conmigo,\ntu encanto llega hasta perpetuar mis sueños." },

    { "start": 38.4, "duration": 0.9, "type": "number", "text": "RAZÓN 5!" },
    { "start": 39.5, "duration": 5.2, "type": "reason", "text": "Mira un año atrás: ¿somos los mismos?\nCreo que somos mejores que antes.\nTe amo, te extraño y te deseo." },

    { "start": 45.1, "duration": 0.9, "type": "number", "text": "RAZÓN 6!" },
    { "start": 46.2, "duration": 4.2, "type": "reason", "text": "Eres la dueña de mis sueños,\nmis misterios y mis pensamientos." },

    { "start": 50.8, "duration": 0.9, "type": "number", "text": "RAZÓN 7!" },
    { "start": 51.9, "duration": 4.6, "type": "reason", "text": "Te ha dibujado un pincel de talento celestial,\na mi manera de ver nunca habría un rival." },

    { "start": 56.9, "duration": 0.9, "type": "number", "text": "RAZÓN 8!" },
    { "start": 58.0, "duration": 4.4, "type": "reason", "text": "Aceptas mis ráfagas de cursilerías, mis enojos,\ny entiendes mi forma de amar." },

    { "start": 62.8, "duration": 16.0, "type": "flower", "text": "" },

    { "start": 79.3, "duration": 0.9, "type": "number", "text": "RAZÓN 9!" },
    { "start": 80.4, "duration": 3.6, "type": "reason", "text": "Tienes todo para ser buena mamá." },

